# Firebase web app config.
#
# Copy to `.env.local` and fill in from:
#   Firebase console -> Project settings -> Your apps -> Web app -> SDK setup
#
# These values are NOT secrets. Firebase web config is shipped to the browser by
# design; access is controlled by security rules, not by hiding the config. The
# NEXT_PUBLIC_ prefix is required for Next.js to expose them to client code, and
# they are INLINED AT BUILD TIME - changing them needs a rebuild, not just a
# restart.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# measurementId is the "G-XXXXXXX" value. Analytics is skipped entirely without it.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Consent gate for analytics. Collection is BLOCKED until the visitor answers
# the consent banner, because GA4 sets cookies (see README). Set to "false" ONLY
# for internal tooling with no public visitors.
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=

# Server-side reporting only (reading daily/monthly visitor counts). These are
# secrets and must NEVER be prefixed with NEXT_PUBLIC_.
# GA4_PROPERTY_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
